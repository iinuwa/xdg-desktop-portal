
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="xyz.iinuwa.credentialsd.Session">
    <method name="Start">
    </method>
    <method name="EnterClientPin">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg name="pin_fd" type="h" direction="in"/>
      <arg name="_options" type="a{sv}" direction="in"/>
    </method>
    <method name="SelectCredential">
      <arg name="id" type="s" direction="in"/>
      <arg name="_options" type="a{sv}" direction="in"/>
    </method>
    <signal name="NeedsPin">
      <arg name="attempts_left" type="u"/>
      <arg name="_options" type="a{sv}"/>
    </signal>
    <!--
     Emitted when the authenticator needs a user verification gesture.
     -->
    <signal name="NeedsUserVerification">
      <arg name="attempts_left" type="u"/>
      <arg name="_options" type="a{sv}"/>
    </signal>
    <!--
     Emitted when the authenticator needs a user presence gesture.
     -->
    <signal name="NeedsUserPresence">
      <arg name="_options" type="a{sv}"/>
    </signal>
    <!--
     Emitted when the authenticator detects multiple credentials matching
     credentials for a request.
     -->
    <signal name="SelectingCredential">
      <arg name="credentials" type="aa{sv}"/>
      <arg name="_options" type="a{sv}"/>
    </signal>
    <!--
     Emitted when the platform begins scanning for CTAP2 hybrid advertisements.
     -->
<signal name="HybridStarted">
  <arg name="_options" type="a{sv}"/>
</signal>
<method name="GetHybridInvocationData">
  <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
  <arg name="invocation_data" type="h" direction="out"/>
</method>
    <!--
     Emitted when the platform has received a CTAP2 hybrid advertisement and is
     establishing a channel.
     -->
    <signal name="HybridConnecting">
      <arg name="_options" type="a{sv}"/>
    </signal>
    <signal name="HybridConnected">
      <arg name="_options" type="a{sv}"/>
    </signal>
    <signal name="NfcConnected">
      <arg name="_options" type="a{sv}"/>
    </signal>
    <signal name="UsbConnected">
      <arg name="_options" type="a{sv}"/>
    </signal>
    <signal name="CeremonyCompleted">
      <arg name="response" type="a{sv}"/>
    </signal>
    <signal name="ErrorOccurred">
      <arg name="error" type="u"/>
    </signal>
    <property name="Devices" type="aa{sv}" access="read"/>
    <property name="RpId" type="s" access="read"/>
  </interface>
</node>
