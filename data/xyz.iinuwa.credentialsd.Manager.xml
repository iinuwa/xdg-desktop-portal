
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="xyz.iinuwa.credentialsd.Manager">
    <method name="CreatePublicKeyCredential">
      <arg name="request_json" type="s" direction="in"/>
      <arg name="origin" type="s" direction="in"/>
      <arg name="top_origin" type="s" direction="in"/>
      <arg name="session_handle" type="o" direction="out"/>
    </method>
    <method name="GetCredential">
      <arg name="origin" type="s" direction="in"/>
      <arg name="top_origin" type="s" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="session_handle" type="o" direction="out"/>
    </method>
  </interface>
</node>
